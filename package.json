{
  "name": "next-redux-starter",
  "description": "Production ready boilerplate for Next.js",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node server.js",
    "pretty": "prettier --write --tab-width 2 \"**/*.js\"",
    "postinstall": "patch-package",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "yarn pretty"
    ]
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@reduxjs/toolkit": "^2.11.2",
    "classnames": "^2.5.1",
    "dotenv": "^8.2.0",
    "embla-carousel": "^8.5.2",
    "embla-carousel-react": "^8.5.2",
    "fastify": "^5.12.8",
    "next": "16.4.6",
    "next-plugin-preact": "^3.0.7",
    "next-runtime-dotenv": "^1.3.0",
    "patch-package": "^8.0.1",
    "preact": "10.29.1",
    "preact-render-to-string": "^6.8.1",
    "radix-ui": "^1.3.4",
    "react": "npm:@preact/compat@^18.3.1",
    "react-dom": "npm:@preact/compat@^18.3.1",
    "react-redux": "^9.1.2",
    "react-ssr-prepass": "npm:preact-ssr-prepass@^1.2.2",
    "wretch": "^2.11.0"
  },
  "devDependencies": {
    "@types/node": "^18.8.5",
    "@types/react": "^18.0.21",
    "@types/redux-logger": "^3.0.9",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.32",
    "prettier": "^3.10.0",
    "redux-logger": "^3.0.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@prefresh/next": "1.7.0",
    "@prefresh/webpack": "4.0.2"
  },
  "resolutions": {
    "ajv/fast-uri": "3.1.9",
    "fastify/@fastify/fast-json-stringify-compiler/fast-json-stringify/fast-uri": "3.1.9",
    "patch-package/tmp": "0.2.7",
    "patch-package/yaml": "2.9.1",
    "patch-package/find-yarn-workspace-root/micromatch": "4.0.8",
    "eslint-config-next/@next/eslint-plugin-next/fast-glob/micromatch": "4.0.8",
    "fastify/@fastify/ajv-compiler/ajv": "8.20.0",
    "fastify/fast-json-stringify/ajv": "8.20.0",
    "fastify/@fastify/ajv-compiler/ajv-formats/ajv": "8.20.0",
    "fastify/@fastify/fast-json-stringify-compiler/fast-json-stringify/ajv": "8.20.0",
    "tailwindcss/chokidar/braces": "3.0.3",
    "tailwindcss/micromatch/picomatch": "2.3.2",
    "tailwindcss/fast-glob/micromatch/picomatch": "2.3.2",
    "tailwindcss/chokidar/anymatch/picomatch": "2.3.2",
    "tailwindcss/chokidar/readdirp/picomatch": "2.3.2"
  },
  "engines": {
    "node": ">=20"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "prettier": {
    "arrowParens": "always",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none"
  }
}
